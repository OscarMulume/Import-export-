# Import-Export — exemple de variables d'environnement (aucune valeur réelle ici)
# Copier vers .env.local et renseigner. Ne jamais committer .env.local.

# Mode démonstration : true = catalogue/paiement de démonstration, aucun débit réel.
NEXT_PUBLIC_DEMO_MODE=true

# URL publique du site (retours de paiement, liens absolus).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Adresse de contact affichée. Laisser vide tant qu'elle n'est pas confirmée.
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase (optionnel). Sans ces valeurs, les commandes restent locales (démo).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Flutterwave — clé publique (navigateur uniquement).
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# Flutterwave — clé secrète (serveur uniquement, ne jamais exposer au navigateur).
FLUTTERWAVE_SECRET_KEY=

# Endpoint serveur de vérification d'un paiement (ex. fonction Supabase Edge).
# Sans cet endpoint, aucun paiement Flutterwave n'est marqué « payé ».
NEXT_PUBLIC_PAYMENT_VERIFY_URL=

# Mobile money manuel — numéros à confirmer (jamais en dur dans le code).
NEXT_PUBLIC_MPESA_NUMBER=
NEXT_PUBLIC_AIRTEL_NUMBER=
NEXT_PUBLIC_ORANGE_NUMBER=
NEXT_PUBLIC_AFRIMONEY_NUMBER=
